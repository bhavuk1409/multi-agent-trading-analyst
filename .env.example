# NEXUS — Multi-Agent Trading Analyst: Environment Variables
# ===========================================================
# Copy this file to .env and fill in your keys.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# GROQ_API_KEY  ← Required
# ---------------------------------------------------------------------------
# Powers all 4 LLM agents (Technical, Fundamental, Sentiment, Risk).
# Get a free key at: https://console.groq.com
# Recommended model: openai/gpt-oss-120b  (set in config/config.yaml)
GROQ_API_KEY=your_groq_api_key_here

# ---------------------------------------------------------------------------
# EXA_API_KEY  ← Optional
# ---------------------------------------------------------------------------
# Enables richer neural-search news articles for the Sentiment Agent.
# If not set, the app falls back to Yahoo Finance news headlines (free).
# Get a key at: https://exa.ai
EXA_API_KEY=your_exa_api_key_here

# ---------------------------------------------------------------------------
# FINNHUB_API_KEY  ← Optional (recommended)
# ---------------------------------------------------------------------------
# Enables sub-second real-time price ticks for the watchlist via Finnhub's
# free WebSocket feed (50 symbols @ 50 msgs/sec). Without it the watchlist
# falls back to 5-second polling of Yahoo Finance (which is 15-min delayed).
# Get a free key at: https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_api_key_here

# ---------------------------------------------------------------------------
# Notes
# ---------------------------------------------------------------------------
# yfinance (Yahoo Finance) is used for all market price data.
# It requires NO API key and is always free.
